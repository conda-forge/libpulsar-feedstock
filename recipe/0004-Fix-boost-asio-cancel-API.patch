From ad9d3888df493baafa58c5d7ddfe99b6e5f154b2 Mon Sep 17 00:00:00 2001
From: "Uwe L. Korn" <uwe.korn@quantco.com>
Date: Wed, 20 May 2026 13:44:09 +0000
Subject: [PATCH] Fix boost::asio::basic_waitable_timer::cancel() API change

---
 lib/AutoClusterFailover.cc | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lib/AutoClusterFailover.cc b/lib/AutoClusterFailover.cc
index 4fdfc1e..7b47251 100644
--- a/lib/AutoClusterFailover.cc
+++ b/lib/AutoClusterFailover.cc
@@ -173,7 +173,7 @@ class AutoClusterFailoverImpl : public std::enable_shared_from_this<AutoClusterF
         ASIO_ERROR ignored;
         context->resolver.cancel();
         context->socket.close(ignored);
-        context->timer.cancel(ignored);
+        context->timer.cancel();
 
         context->callback(success);
     }
